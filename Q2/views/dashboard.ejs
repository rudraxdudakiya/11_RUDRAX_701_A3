<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard (Protected Route 1)</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container wide">
        <div class="nav">
            <div class="nav-links">
                <a href="/dashboard" class="active">Dashboard (Route 1)</a>
                <a href="/profile">Profile (Route 2)</a>
            </div>
            <a href="/logout" class="btn-logout">Logout</a>
        </div>

        <div class="header">
            <h1>Welcome, <%= user.name %>!</h1>
            <p>Protected Route 1 &mdash; User Dashboard</p>
        </div>

        <div class="card">
            <h3>Session Information (Stored on File System)</h3>
            <p style="font-size: 13px; color: #555; margin-top: 5px;">
                Your session is persisted in the server's file session store directory: <code>./sessions/</code>
            </p>
        </div>

        <table class="info-table">
            <tr>
                <th>Session ID</th>
                <td><code><%= sessionId %></code></td>
            </tr>
            <tr>
                <th>Session File</th>
                <td><code><%= sessionId %>.json</code></td>
            </tr>
            <tr>
                <th>Logged In As</th>
                <td><strong><%= user.username %></strong> (<%= user.email %>)</td>
            </tr>
            <tr>
                <th>Role</th>
                <td><span class="badge-role"><%= user.role %></span></td>
            </tr>
            <tr>
                <th>Login Timestamp</th>
                <td><%= user.loginTime %></td>
            </tr>
            <tr>
                <th>Session Store Type</th>
                <td>File Session Store (JSON files on disk)</td>
            </tr>
        </table>

        <div class="hint-box">
            This route is protected. If you logout or delete your session cookie, visiting <code>/dashboard</code> will automatically redirect to the login page.
        </div>
    </div>
</body>
</html>
