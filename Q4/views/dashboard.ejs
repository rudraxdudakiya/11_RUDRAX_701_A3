<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ERP Admin Panel - Employee Management</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="container wide">
        <div class="top-bar">
            <div>
                <strong>ERP System &mdash; Admin Panel</strong>
            </div>
            <div>
                <span style="font-size: 13px; color: #555; margin-right: 15px;">Logged in as: <strong>
                        <%= adminUser %>
                    </strong></span>
                <a href="/logout" class="btn-danger">Logout</a>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <div class="header" style="margin-bottom: 0;">
                <h1>Employees Management</h1>
                <p>CRUD operations with encrypted passwords, salary calculation, and email notification</p>
            </div>
            <a href="/employees/add" class="btn-success">+ Add New Employee</a>
        </div>

        <% if (errorMessage) { %>
            <div class="alert-danger">
                <%= errorMessage %>
            </div>
            <% } %>

                <% if (successMessage) { %>
                    <div class="alert-success">
                        <%= successMessage %>
                    </div>
                    <% } %>

                        <div class="table-responsive">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Emp ID</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Password (Generated)</th>
                                        <th>Department</th>
                                        <th>Designation</th>
                                        <th>Basic</th>
                                        <th>HRA (+20%)</th>
                                        <th>DA (+10%)</th>
                                        <th>Deduct (-5%)</th>
                                        <th>Net Salary</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (employees && employees.length> 0) { %>
                                        <% employees.forEach(emp=> { %>
                                            <tr>
                                                <td><strong>
                                                        <%= emp.empid %>
                                                    </strong></td>
                                                <td>
                                                    <%= emp.name %>
                                                </td>
                                                <td>
                                                    <%= emp.email %>
                                                </td>
                                                <td><code
                                                        style="background: #eef2ff; color: #4338ca; padding: 3px 6px; border-radius: 4px; font-weight: bold;"><%= emp.rawPassword || 'Not Set' %></code>
                                                </td>
                                                <td><span class="badge">
                                                        <%= emp.department %>
                                                    </span></td>
                                                <td>
                                                    <%= emp.designation %>
                                                </td>
                                                <td>₹<%= emp.basicSalary.toLocaleString() %>
                                                </td>
                                                <td>₹<%= emp.hra.toLocaleString() %>
                                                </td>
                                                <td>₹<%= emp.da.toLocaleString() %>
                                                </td>
                                                <td>₹<%= emp.deductions.toLocaleString() %>
                                                </td>
                                                <td><strong style="color: #28a745;">₹<%= emp.netSalary.toLocaleString()
                                                            %></strong></td>
                                                <td style="white-space: nowrap;">
                                                    <a href="/employees/edit/<%= emp._id %>"
                                                        class="btn-warning">Edit</a>
                                                    <form action="/employees/delete/<%= emp._id %>" method="POST"
                                                        style="display: inline;"
                                                        onsubmit="return confirm('Are you sure you want to delete employee <%= emp.empid %>?');">
                                                        <button type="submit" class="btn-danger">Delete</button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="12"
                                                            style="text-align: center; padding: 25px; color: #777;">
                                                            No employees found. Click "Add New Employee" to register
                                                            one.
                                                        </td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <div class="hint-box">
                            <strong>Salary Formula Applied:</strong>
                            <code>Net Salary = Basic Salary + HRA (20%) + DA (10%) - Deductions (5%)</code>.<br>
                            When an employee is created, a unique <code>empid</code> and <code>password</code> are
                            generated, password is encrypted with <code>bcrypt</code>, and credentials are emailed to
                            the employee.
                        </div>
    </div>
</body>

</html>